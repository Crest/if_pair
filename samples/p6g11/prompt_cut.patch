+/*
+ * Put kc at the ring's head, its turn kept (S4.9): the pass goes on after what
+ * stopped it, before anything new starts here, with no refill when it is taken.
+ */
+static void
+ks_ring_keep(struct kwq_worker *kw, struct kwq_cpu *kc)
+{
+	TAILQ_INSERT_HEAD(&kw->kw_active, kc, kc_active);
+	kc->kc_onlist = KWQ_ON_ACTIVE;
+	kc->kc_warm |= KWQ_KEPT;
+	kw->kw_nactive++;
+	kw->kw_ring_left++;
+}
+
+static bool
+ks_kept_first(struct kwq_worker *kw)
+{
+	struct kwq_cpu *kc = TAILQ_FIRST(&kw->kw_active);
+
+	return (kc != NULL && (kc->kc_warm & KWQ_KEPT) != 0);
+}
+
