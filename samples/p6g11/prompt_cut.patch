+atf_test_case prompt_cut cleanup
+prompt_cut_head() {
+	atf_set descr "prompt_cut: with item_min_us 1 s no budget stops a write, so reads on a KWQ_F_PROMPT queue on the same CPU are what stops writes part way, and what was written reads back"
+	atf_set require.user root
+}
+prompt_cut_body() {
+	local cut i r
+	kwqeli_setup
+	knob kern.geom.kwqeli.cpu 1
+	knob kern.geom.kwqeli.stealable 0
+	knob kern.geom.kwqeli.read_queue 2
+	knob kern.kwq.bulk.item_min_us 1000000
+	knob kern.kwq.bulk.prompt_cut 1
+	m=$(newmd 96m)
+	atf_check -o ignore geli init -B none -P -K key -s 4096 "$m"
+	atf_check $GK attach -p -k key "$m"
+	dd if=data.in of=data.cmp bs=1m count=32 2>/dev/null
+	dd if=data.cmp of="/dev/$m.kweli" bs=1m 2>/dev/null || atf_fail "write"
+	(i=0; while [ $i -lt 6 ]; do
+		dd if="/dev/$m.kweli" of=/dev/null bs=4k count=8000 2>/dev/null
+		i=$((i + 1))
+	done) &
+	r=$!
+	i=0
+	while [ $i -lt 6 ]; do
+		dd if=data.cmp of="/dev/$m.kweli" bs=1m oseek=32 2>/dev/null || atf_fail "write beside reads"
+		i=$((i + 1))
+	done
+	wait $r
+	cut=$(qsum "$m" requeued)
+	dd if="/dev/$m.kweli" of=data.out bs=1m count=32 2>/dev/null || atf_fail "read"
+	cmp -s data.cmp data.out || atf_fail "read back something else"
+	dd if="/dev/$m.kweli" of=data.out bs=1m iseek=32 count=32 2>/dev/null || atf_fail "read"
+	cmp -s data.cmp data.out || atf_fail "read back something else beside reads"
+	echo "prompt_cut: $cut writes stopped part way"
+	[ "$cut" -gt 0 ] || atf_skip "no write was stopped: the reads never met one"
+}
+prompt_cut_cleanup() { kwqeli_cleanup; }
+
