+
+static int
+gif_transmit(struct ifnet *ifp, struct mbuf *m)
+{
+	struct mbuf *chain;
+	uint32_t af;
+	int error;
+
+	NET_EPOCH_ASSERT();
+#ifdef MAC
+	error = mac_ifnet_check_transmit(ifp, m);
+	if (error) {
+		m_freem(m);
+		goto err;
+	}
+#endif
+	error = ENETDOWN;
+	if ((ifp->if_flags & IFF_MONITOR) != 0 ||
+	    (ifp->if_flags & IFF_UP) == 0 ||
+	    (ifp->if_drv_flags & IFF_DRV_RUNNING) == 0 ||
+	    ((struct gif_softc *)ifp->if_softc)->gif_family == 0 ||
+	    (error = if_tunnel_check_nesting(ifp, m, MTAG_GIF,
+		V_max_gif_nesting)) != 0) {
 		m_freem(m);
+		goto err;
 	}
+	/* Now pull back the af that we stashed in the csum_data. */
+	af = m->m_pkthdr.csum_data;
+	/*
+	 * Software TSO (tcp_tso_chop() native adopter): a chain
+	 * accepted under our IFCAP_TSO grant is split back to
+	 * <= if_mtu segments HERE, before encapsulation, so each
+	 * segment encapsulates exactly like an ordinary packet.
+	 * gif advertises no TXCSUM, so flags 0: the chopper computes
+	 * full software checksums (matching what tcp_output() would
+	 * have done without the grant).  EPROTONOSUPPORT is
+	 * unreachable in practice - the stack maps M_EXTPG payload
+	 * before non-MEXTPG interfaces - so every failure is a drop.
+	 */
+	if ((m->m_pkthdr.csum_flags & CSUM_TSO) != 0) {
+		error = tcp_tso_chop(&m, 0, ifp->if_mtu, 0, &chain);
+		if (error != 0) {
+			m_freem(m);	/* NULL on ENOBUFS; that's fine */
+			goto err;
+		}
+		while ((m = chain) != NULL) {
+			chain = m->m_nextpkt;
+			m->m_nextpkt = NULL;
+			if (error == 0)
+				error = gif_transmit1(ifp, m, af);
+			else
+				m_freem(m);
+		}
+		/* gif_transmit1() counted any error itself. */
+		return (error);
+	}
+	return (gif_transmit1(ifp, m, af));
 err:
 	if (error)
 		if_inc_counter(ifp, IFCOUNTER_OERRORS, 1);
@@ -609,6 +665,22 @@
 			return (EINVAL);
 		else
 			ifp->if_mtu = ifr->ifr_mtu;
+		return (0);
+	case SIOCSIFCAP:
+		/*
+		 * TSO4/TSO6 are the only toggleable capabilities.  gif
+		 * advertises no TXCSUM, so there is no coupling to
+		 * maintain - the chopper always computes full software
+		 * checksums.  The hwassist mapping is what grants
+		 * tcp_output() permission to build chains.
+		 */
+		ifp->if_capenable = ifr->ifr_reqcap &
+		    (IFCAP_TSO4 | IFCAP_TSO6 | IFCAP_LINKSTATE);
+		ifp->if_hwassist = 0;
+		if (ifp->if_capenable & IFCAP_TSO4)
+			ifp->if_hwassist |= CSUM_IP_TSO;
+		if (ifp->if_capenable & IFCAP_TSO6)
+			ifp->if_hwassist |= CSUM_IP6_TSO;
 		return (0);
 	}
 	sx_xlock(&gif_ioctl_sx);
